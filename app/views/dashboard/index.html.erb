<div class="flex h-screen">
  <!-- Sidebar -->
  <%= render "layouts/sidebar" %>

  <!-- Conteúdo Principal -->
  <main class="flex-1 p-6 transition-all duration-300 md:ml-64">
    <!-- Botão para abrir o menu no mobile -->
    <button data-action="click->sidebar#toggle" class="md:hidden bg-gray-700 text-white px-4 py-2 rounded mb-4">
      ☰ Menu
    </button>

    <!-- Botões de navegação -->
    <div class="mb-6">
      <%= link_to "Questionários", questionnaires_path, class: "inline-block bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 mb-4" %>
      <% if current_user.admin? %>
        <%= link_to "Gerenciamento", admin_root_path, class: "inline-block bg-green-500 text-white px-6 py-3 rounded-lg hover:bg-green-600" %>
      <% end %>
    </div>

    <!-- Título -->
    <h1 class="text-2xl font-bold mb-6">Lista de Questionários</h1>

    <!-- Grid responsivo para os questionários -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @questionnaires.each do |questionnaire| %>
        <div class="bg-white shadow-lg rounded-lg p-6 border border-gray-200 hover:shadow-xl transition">
          <h3 class="text-xl font-semibold mb-3 text-gray-900"><%= questionnaire.name %></h3>
          <p class="text-gray-600 mb-4"><%= questionnaire.classroom_info %></p>
          <%= link_to "Responder", new_questionnaire_submission_path(questionnaire), class: "mt-4 inline-block bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition" %>
        </div>
      <% end %>
    </div>
  </main>
</div>
