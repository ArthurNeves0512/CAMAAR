<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h2>Recuperar Senha</h2>
        </div>
        <div class="card-body">
          <%= form_with scope: :user, url: user_password_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", autofocus: true, required: true %>
            </div>
            <div class="d-grid">
              <%= f.submit "Recuperar", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
