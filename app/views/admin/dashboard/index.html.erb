<div class="flex h-screen bg-gray-200">
  <!-- Botão do menu para telas menores -->
  <button id="menu-btn" class="md:hidden p-3 bg-gray-700 text-white fixed top-4 left-4 rounded">
    ☰ Menu
  </button>
  <!-- Sidebar com largura fixa -->
  <div class="w-64">
    <%= render "layouts/sidebar" %>
  </div>
  <!-- Conteúdo Principal -->
  <div class="flex flex-1 justify-center items-center relative">
    <div class="bg-white p-10 rounded-lg shadow-md flex flex-col gap-4 w-80">
      <% if flash[:alert] %>
        <h1 class="text-red-500 font-bold text-center"><%= flash[:alert] %></h1>
      <% end %>
      <%= link_to "Importar Dados", new_admin_import_path, class: "transition-colors duration-300 ease-in-out bg-green-300 text-white py-3 rounded-md text-center font-semibold" %>
      <%= link_to "Editar Templates", admin_templates_path, class: "transition-colors duration-300 ease-in-out bg-green-300 text-white py-3 rounded-md text-center font-semibold" %>
      <!-- Botão para abrir o modal -->
      <button id="open-modal" class="transition-colors duration-300 ease-in-out bg-green-300 text-white py-3 rounded-md text-center font-semibold">
        Enviar Formulários
      </button>
      <%= link_to "Resultados", admin_results_path, class: "transition-colors duration-300 ease-in-out bg-green-300 text-white py-3 rounded-md text-center font-semibold" %>
    </div>
    <!-- Modal para Seleção de Template e Turmas -->
    <div id="modal" class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden">
      <div class="bg-white p-6 rounded-lg shadow-md w-[500px]">
        <form id="questionnaire-form" method="POST" action="<%= admin_questionnaires_path %>">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <!-- Campo para o Nome do Questionário -->
          <label class="block mb-2 font-semibold">Nome do Questionário:</label>
          <input type="text" id="questionnaire_name" name="name" 
                 class="w-full p-2 border rounded-md" placeholder="Digite o nome do questionário">
          <!-- Seleção de Template -->
          <label class="block mb-2 font-semibold mt-4">Template:</label>
          <select id="template_id" name="template_id" class="w-full p-2 border rounded-md">
            <% @templates.each do |template| %>
              <option value="<%= template.id %>"><%= template.name %></option>
            <% end %>
          </select>
          <!-- Lista de Turmas -->
          <div class="mt-4 overflow-y-auto max-h-52 border p-2 rounded-md" id="classrooms-container">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b">
                  <th class="px-2 py-1">Nome</th>
                  <th class="px-2 py-1">Semestre</th>
                  <th class="px-2 py-1">Código</th>
                </tr>
              </thead>
              <tbody>
                <% @classrooms.each do |classroom| %>
                  <tr class="border-b">
                    <td class="px-2 py-1">
                      <div class="flex items-center gap-2">
                        <input type="checkbox" name="classroom_codes[]"
                               value="<%= classroom.code %>" class="classroom-checkbox">
                        <span><%= "Estudos Em" %></span>
                      </div>
                    </td>
                    <td class="px-2 py-1"><%= classroom.semester %></td>
                    <td class="px-2 py-1"><%= classroom.code %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <!-- Botões do Modal -->
          <div class="mt-4 flex justify-between">
            <button type="button" id="close-modal" class="bg-red-300 text-white py-2 px-4 rounded-md hover:bg-red-600 transition-colors duration-300 ease-in-out">
              Cancelar
            </button>
            <button type="submit" class="bg-green-300 text-white py-2 px-6 rounded-md hover:bg-green-600 transition-colors duration-300 ease-in-out">
              Enviar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  // Abrir o modal
  document.getElementById('open-modal').addEventListener('click', function () {
    document.getElementById('modal').classList.remove('hidden');
  });

  // Fechar o modal
  document.getElementById('close-modal').addEventListener('click', function () {
    document.getElementById('modal').classList.add('hidden');
  });

  // Validação do formulário
  document.getElementById('questionnaire-form').addEventListener('submit', function (e) {
    const questionnaireName = document.getElementById('questionnaire_name').value.trim();
    const classroomsSelecionadas = document.querySelectorAll('.classroom-checkbox:checked');

    resetErrorStyles();

    if (!questionnaireName) {
      highlightError("questionnaire_name", "Digite um nome para o questionário!");
      e.preventDefault();
      return;
    }

    if (classroomsSelecionadas.length === 0) {
      highlightError("classrooms", "Selecione pelo menos uma turma!");
      e.preventDefault();
      return;
    }

    // Fechar o modal após envio válido
    document.getElementById('modal').classList.add('hidden');
  });

  // Função para destacar erros
  function highlightError(field, message) {
    if (field === "questionnaire_name") {
      const fieldElement = document.getElementById(field);
      fieldElement.classList.add('border-red-500', 'bg-red-100');
      alert(message);
    }

    if (field === "classrooms") {
      const classroomsContainer = document.getElementById('classrooms-container');
      classroomsContainer.classList.add('border-red-500', 'bg-red-100');
      alert(message);
    }
  }

  // Resetar estilos de erro
  function resetErrorStyles() {
    const questionnaireInput = document.getElementById('questionnaire_name');
    const classroomsContainer = document.getElementById('classrooms-container');

    questionnaireInput.classList.remove('border-red-500', 'bg-red-100');
    classroomsContainer.classList.remove('border-red-500', 'bg-red-100');
  }

  // Resetar erros ao interagir com os campos
  document.getElementById('questionnaire_name').addEventListener('click', resetErrorStyles);
  document.getElementById('classrooms-container').addEventListener('click', resetErrorStyles);

  // Efeito de hover para botões
  document.addEventListener('DOMContentLoaded', function () {
    const elements = document.querySelectorAll('.bg-green-300');
    elements.forEach(element => {
      element.addEventListener('mouseover', function () {
        this.classList.replace('bg-green-300', 'bg-green-600');
      });
      element.addEventListener('mouseout', function () {
        this.classList.replace('bg-green-600', 'bg-green-300');
      });
    });
  });
</script>