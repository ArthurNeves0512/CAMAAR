<div class="flex h-screen bg-gray-200">
  <h1 style="color:red;"><%= flash[:alert] %></h1>
  <!-- Sidebar -->
  <button id="menu-btn" class="md:hidden p-3 bg-gray-700 text-white fixed top-4 left-4 rounded">
    ☰ Menu
  </button>
  <div class="flex h-screen">
    <!-- Sidebar -->
    <%= render "layouts/sidebar" %>
    <!-- Conteúdo Principal -->
    <main class="flex-1 p-6 ml-64"> <!-- Adicionando margem esquerda para compensar a sidebar -->
      <!-- Cabeçalho -->
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Avaliações</h1>
      </div>
      <!-- Centralizando os questionários -->
      <div class="flex flex-wrap justify-center gap-6">
        <% @questionnaires.each do |questionnaire| %>
          <div class="bg-white shadow-md rounded-lg p-6 border border-gray-300 max-w-xs w-full">
            <h3 class="text-lg font-bold text-gray-900"><%= questionnaire.name %></h3>
            <p class="text-sm text-gray-600">
              <%= questionnaire.template.semester if questionnaire.template %>
            </p>
            <p class="text-sm font-semibold text-gray-800">
              <% classroom = Classroom.find_by(id: questionnaire.classroom_info) %>
              <% professor = classroom&.enrollments&.joins(:user)&.where(users: { role: "professor" })&.first&.user %>
              <%= professor ? professor.nome : "Professor não atribuído" %>
            </p>
            <!-- Botão para acessar o questionário -->
            <%= link_to "Acessar", admin_questionnaire_submissions_path(questionnaire),
                          class: "block mt-4 bg-green-500 text-white text-center py-2 px-4 rounded-md hover:bg-green-600" %>
          </div>
        <% end %>
      </div>
    </main>
  </div>
</div>
