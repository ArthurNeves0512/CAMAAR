<%= form_for([@template, @question], url: admin_template_question_path(@template, @question), html: { class: "space-y-6" }) do |f| %>
  <div class="mb-4">
    <%= f.label :text, "Texto da Questão", class: "block text-sm font-semibold text-gray-700" %>
    <%= f.text_area :text, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", placeholder: "Texto da questão" %>
  </div>

  <div class="mt-6">
    <%= f.submit "Atualizar Questão", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
  </div>
<% end %>
