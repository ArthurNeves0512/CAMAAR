<h2 class="text-xl font-semibold mb-4">Criar Nova Questão</h2>

<%= form_for([@template, @question], url: admin_template_questions_path(@template), html: { class: "space-y-6" }) do |f| %>
  <div class="mb-4">
    <%= f.label :name, "Nome da Questão", class: "block text-sm font-semibold text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", placeholder: "Nome da questão" %>
  </div>
  
  <div class="mb-4">
    <%= f.label :text, "Texto da Questão", class: "block text-sm font-semibold text-gray-700" %>
    <%= f.text_area :text, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", placeholder: "Texto da questão" %>
  </div>

  <div class="mb-4">
    <%= f.label :question_type, "Tipo da Questão", class: "block text-sm font-semibold text-gray-700" %>
    <%= f.select :question_type, ["Escolha múltipla", "Dissertativa", "Verdadeiro ou Falso"], class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50" %>
  </div>

  <%= f.submit "Salvar Questão", class: "btn btn-primary" %>
<% end %>
