<style>
  .padder {
  padding: 0.25rem;
  padding-left: 0.75rem;
  }
</style>
<div class="flex h-screen bg-gray-200">
  <!-- Sidebar -->
  <div class="w-64 bg-white shadow-md">
    <%= render "layouts/sidebar" %>
  </div>
  <!-- Conteúdo Principal -->
  <div class="flex flex-1 flex-col p-6 overflow-x-auto">
    <!-- Título -->
    <h1 class="text-2xl font-bold mb-4" style="text-align: center;">Editar Template</h1>
    <!-- Formulário de Edição do Template -->
    <%= form_for @template, url: admin_template_path(@template), method: :patch, html: { class: "space-y-6" } do |f| %>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <!-- Nome do Template -->
        <div class="mb-4">
          <%= f.label :name, "Nome", class: "block text-sm font-semibold text-gray-700" %>
          <%= f.text_field :name, class: "padder mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", placeholder: "Nome do template" %>
        </div>
        <!-- Público Alvo -->
        <div class="mb-4">
          <%= f.label :target_audience, "Público-Alvo", class: "block text-sm font-semibold text-gray-700" %>
          <%= f.text_field :target_audience, class: "padder mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", placeholder: "Público alvo do template" %>
        </div>
        <!-- Semestre -->
        <div class="mb-4">
          <%= f.label :semester, "Semestre", class: "block text-sm font-semibold text-gray-700" %>
          <%= f.text_field :semester, class: "padder mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-500 focus:ring-opacity-50", placeholder: "Semestre do template" %>
        </div>
        <!-- Botão Salvar -->
        <div class="flex justify-end gap-4">
          <%= link_to "Cancelar", admin_templates_path, class: "text-red-600 px-4 py-2 rounded-md btn btn-outline-danger" %>
          <%= f.submit "Salvar", class: "text-green px-4 py-2 rounded-md btn btn-outline-success" %>
        </div>
      </div>
    <% end %>
    <!-- Seção de Questões -->
    <div class="bg-white p-6 rounded-lg shadow-md mt-6">
      <h2 class="text-xl font-semibold mb-4">Questões do Template</h2>
      <% if @template.questions.any? %>
        <ul class="space-y-4">
          <% @template.questions.each do |question| %>
            <li class="bg-gray-100 p-4 rounded-md shadow-sm">
              <p><strong>Texto:</strong> <%= question.text %></p>
              <p><strong>Tipo:</strong> <%= question.question_type.humanize %></p>
              <div class="flex justify-end gap-2 mt-2">
                <!-- Editar Questão -->
                <%= link_to "Editar", edit_admin_template_question_path(@template, question), class: "padder text-blue-600 hover:text-blue-800" %>
                <!-- Excluir Questão (com button_to) -->
                <%= button_to admin_template_question_path(@template, question),
                              method: :delete,
                              data: { confirm: "Tem certeza que deseja excluir esta questão?" },
                              class: "padder text-red-600 hover:text-red-800 bg-transparent border-0 cursor-pointer" do %>
                  <span>Excluir</span>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-gray-500">Nenhuma questão cadastrada para este template.</p>
      <% end %>
      <!-- Botão para Adicionar Nova Questão -->
      <div class="mt-6">
        <%= link_to "Adicionar Questão", new_admin_template_question_path(@template), class: "text-blue-600 hover:text-blue-800" %>
      </div>
    </div>
  </div>
</div>