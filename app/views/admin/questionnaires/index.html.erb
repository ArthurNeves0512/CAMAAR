<h1>Lista de Questionários</h1>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
  
  <% if flash[:alert] %>
      <h1><%=flash[:alert]%></h1>
    <%end%>
    <% @questionnaires.each do |questionnaire| %>
      <tr>
        <td><%= questionnaire.name %></td>
        <td>
          <%= link_to 'Ver', admin_questionnaire_path(questionnaire) %> |
          <%= link_to 'Editar', edit_admin_questionnaire_path(questionnaire) %> |
          <%= link_to 'Deletar', admin_questionnaire_path(questionnaire), method: :delete, data: { confirm: 'Tem certeza?' } %>
           <%= link_to 'Exportar dados', exportar_path(questionnaire) %>
           
           
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Voltar', admin_root_path, class: 'btn' %>
<%= link_to 'Novo Questionário', new_admin_questionnaire_path, class: 'btn' %>
