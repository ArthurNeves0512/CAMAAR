<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Eds" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- TailwindCSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      /* Ensure flash container doesn't block clicks when empty */
      #flash-messages {
        pointer-events: none;
      }
      #flash-messages .alert {
        pointer-events: auto;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <!-- Flash Messages Fixed at Top -->
    <div id="flash-messages" class="fixed top-0 left-0 right-0 z-50 p-4">
      <% flash.each do |type, message| %>
        <% alert_class = type == 'notice' ? 'alert-success' : 'alert-danger' %>
        <div class="alert <%= alert_class %> alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
          <%= message %>
          <!-- Remove data-bs-dismiss attribute so we can handle the click -->
          <button type="button" class="btn-close" aria-label="Close"></button>
        </div>
      <% end %>
    </div>
    <!-- Main Content (no extra margin needed since flash is overlaying) -->
    <div class="flex-1">
      <%= yield %>
    </div>
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        // Helper function to animate fade out and dismiss alert
        function dismissAlert(alert) {
          // Avoid re-triggering if already fading out
          if (!alert.classList.contains('animate__fadeOutUp')) {
            alert.classList.remove('animate__fadeInDown');
            alert.classList.add('animate__fadeOutUp');
            // After animation duration (approx. 1s), close the alert
            setTimeout(function() {
              bootstrap.Alert.getOrCreateInstance(alert).close();
            }, 1000);
          }
        }

        // Auto-dismiss flash alerts after 5 seconds using the helper
        document.querySelectorAll('#flash-messages .alert').forEach(function(alert) {
          setTimeout(function() {
            dismissAlert(alert);
          }, 5000);
        });

        // When the close button is clicked, trigger the fade-out animation
        document.querySelectorAll('#flash-messages .alert .btn-close').forEach(function(btn) {
          btn.addEventListener('click', function(event) {
            event.preventDefault();
            let alert = event.target.closest('.alert');
            dismissAlert(alert);
          });
        });

        // Example: Toggling sidebar if applicable.
        const menuBtn = document.getElementById("menu-btn");
        const sidebar = document.getElementById("sidebar");
        if (menuBtn && sidebar) {
          menuBtn.addEventListener("click", function() {
            sidebar.classList.toggle("-translate-x-full");
          });
        }
      });
    </script>
  </body>
</html>
