<div class="container min-vh-100 d-flex flex-column justify-content-center align-items-center">
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-primary mb-4">Bem-vindo ao CAMAAR</h1>
    <p class="lead text-muted">Sistema para avaliação de atividades acadêmicas remotas do CIC</p>
  </div>
  <div class="shadow-lg p-5 bg-white rounded" style="width: 100%; max-width: 400px;">
    <div class="card-body text-center">
      <% if user_signed_in? %>
        <%= link_to "Acessar Dashboard", authenticated_root_path, 
                    class: "btn btn-primary btn-lg w-100 rounded my-3 fw-bold" %>
      <% else %>
        <div class="d-grid gap-3">
          <%= link_to "Entrar", new_user_session_path, 
                    class: "btn btn-primary btn-lg rounded fw-bold py-3" %>
          <%= link_to "Cadastrar", new_user_registration_path, 
                    class: "btn btn-outline-primary btn-lg rounded fw-bold py-3" %>
        </div>
      <% end %>
    </div>
  </div>
  <% unless user_signed_in? %>
    <%# <p class="mt-4 text-muted text-center">
  Ao cadastrar, você concorda com nossos 
  <a href="#" class="text-decoration-none">Termos de Serviço</a>
</p> %>
  <% end %>
</div>