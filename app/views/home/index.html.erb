<h1>Bem-vindo ao Sistema de Questionários</h1>

<% if user_signed_in? %>
  <%= link_to "Acessar Dashboard", authenticated_root_path, class: "btn btn-primary" %>
<% else %>
  <%= link_to "Login", new_user_session_path, class: "btn btn-success" %>
  <%= link_to "Cadastrar", new_user_registration_path, class: "btn btn-info" %>
<% end %>
